{
  // NOTE: This should be able to catch github-actions and npm!

  // Overall Renovate config
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>AnarchoBooleanism/renovate-config#v4.0.0"
  ],

  "packageRules": [
    // Package groups (for tightly-bound packages)
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom"
      ]
    },
    {
      "groupName": "testing-library",
      "matchPackageNames": [
        "@testing-library/jest-dom",
        "@testing-library/react",
        "@testing-library/user-event"
      ]
    },
    {
      "groupName": "eslint",
      "matchPackageNames": [
        "eslint",
        "eslint-plugin-react"
      ]
    },
    {
      "groupName": "vite",
      "matchPackageNames": [
        "@vitejs/plugin-react",
        "vite",
        "vite-plugin-eslint"
      ]
    }
  ]
}
